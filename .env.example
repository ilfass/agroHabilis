PORT=3000
DATABASE_URL=postgresql://usuario:password@localhost:5432/agrohabilis

# Backups PostgreSQL (scripts/backup-dump.js). En tu PC para traer dump del VPS: BACKUP_SSH_TARGET + BACKUP_REMOTE_APP_DIR y npm run backup:pull
# BACKUP_LOCAL_DIR=/ruta/absoluta/backups
# PGDUMP_BIN=/usr/bin/pg_dump
# PGDUMP_VERBOSE=1
# Solo en tu máquina local (no subir al VPS si no hace falta):
# BACKUP_SSH_TARGET=usuario@ip_o_host
# BACKUP_REMOTE_APP_DIR=/ruta/absoluta/al/repo/en/vps
# BACKUP_SSH_EXTRA=-i /home/tu/.ssh/id_ed25519
# Rotación de agrohabilis_*.dump en BACKUP_LOCAL_DIR (npm run backup:rotate o scripts/backup-cron.sh). 0 = desactivar
# BACKUP_RETENTION_DAYS=14

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Inventario WhatsApp: fallback con LLM si la heurística no entiende la frase (requiere GEMINI_API_KEY). Desactivar: 0|false|off
# INVENTARIO_NL_LLM=1
# Clasificador de intención WhatsApp (solo JSON; sin fuentes.md ni Groq/OpenRouter). Si no definís modelo, usa GEMINI_MODEL.
# GEMINI_INTENT_MODEL=gemini-flash-latest
# INTENT_CLASSIFIER_MODEL=gemini-flash-latest
# INTENT_CLASSIFIER_TIMEOUT_MS=8000
# INTENT_CLASSIFIER_MAX_OUTPUT_TOKENS=256
# Google Search grounding (Gemini): con GEMINI_API_KEY configurada queda activo por defecto en consultas con huecos (hortícolas, precio sin BD, etc.). Desactivar: GEMINI_GROUNDING_ENABLED=0|false|off
# GEMINI_GROUNDING_ENABLED=0
# GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# GEMINI_GROUNDING_MAX_CHARS=1000
# GEMINI_GROUNDING_TIMEOUT_MS=28000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Límite por proveedor (axios Groq/OpenRouter y tope en Gemini SDK), ms
IA_TIMEOUT_MS=15000
# Orden de fallback entre proveedores (coma)
IA_PROVIDER_ORDER=gemini,groq,openrouter

WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_CLIENT_ID=agrohabilis
# Solo digitos, sin +. Varios admins: separados por coma (ej: 5492494650386,54911...)
WHATSAPP_DESTINO=
WHATSAPP_ADMIN_NUMBERS=
# En VPS conviene ruta fuera del deploy: WHATSAPP_SESSION_PATH=/var/lib/agrohabilis/whatsapp-session
# Reintentos de QR antes de desconectar (default 200; max interno 10000)
# WHATSAPP_QR_MAX_RETRIES=300
# Reintentos de client.initialize() tras desconexion (default 10; max 100)
# WHATSAPP_MAX_RECONNECT_ATTEMPTS=15
# QR en terminal: por defecto tamaño grande (Unicode). Pantalla angosta / logs: WHATSAPP_QR_TERMINAL_SMALL=1 (ASCII chico)
# WHATSAPP_QR_TERMINAL_SMALL=
# PNG del QR solo en disco (junto a WHATSAPP_SESSION_PATH, no publico). Desactivar: WHATSAPP_QR_PNG=0
# WHATSAPP_QR_PNG=1
# Ruta fija al PNG (absoluta o relativa al cwd); por defecto: <session>/_whatsapp_linking_qr.png
# WHATSAPP_QR_PNG_PATH=
# Tras conectar: procesar mensajes no leidos (1:default). Desactivar: WHATSAPP_DRENAR_NO_LEIDOS=0
# WHATSAPP_DRENAR_NO_LEIDOS=1
# Espera ms antes del drenaje (evita solaparse con eventos message al reconectar)
# WHATSAPP_DRENAR_DELAY_MS=2500

# Solo dígitos, sin +. Lista de hasta 32 números: guarda en BD cada mensaje usuario + cada respuesta del bot (hilo completo) para análisis / tuning. Export: npm run export:capturas
CAPTURA_HILO_WHATSAPP=

# VPS: ruta al Chromium del sistema (opcional; evita fallos de libs con el Chrome embebido)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_SUB_BACK_URL=
WHATSAPP_RETURN_URL=https://wa.me/?text=Hola%20AgroHabilis
# Con token TEST- usar checkout sandbox (por defecto sí). Forzar sandbox: MP_FORCE_SANDBOX_CHECKOUT=1
MP_FORCE_SANDBOX_CHECKOUT=
MP_CURRENCY_ID=ARS
MP_SUB_FREQUENCY=1
MP_SUB_FREQUENCY_TYPE=months
PLAN_BASICO_MONTO=9000
PLAN_PRO_MONTO=18000
JWT_SECRET=
ADMIN_KEY=
# Horas en que un masivo admin sigue en historial como contexto de “feedback” (luego se excluye; default 24, máx. 168)
# BROADCAST_FEEDBACK_WINDOW_HOURS=24
# Pausa entre mensajes del envío masivo admin (ms); reduce riesgo de límites de WhatsApp
ADMIN_BROADCAST_DELAY_MS=650
# Espera máx. a que WhatsApp esté listo antes de arrancar un envío masivo (ms; VPS lento / post-restart)
ADMIN_BROADCAST_WHATSAPP_READY_MS=180000
# Espera máx. antes de cada sendMessage si el cliente aún no está listo (ms)
WHATSAPP_SEND_READY_TIMEOUT_MS=120000
CLIENT_DASHBOARD_URL=https://agro.habilispro.com/dashboard/cliente/login
CLIENT_SESSION_TTL_MS=43200000
CLIENT_TEMP_PASSWORD_LENGTH=10
CLIENT_TEMP_PASSWORD_TTL_HOURS=24
CLIENT_PASSWORD_BCRYPT_ROUNDS=10
CLIENT_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CLIENT_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Reenvío de contraseña temporal (panel cliente): ventana y tope por IP+número
CLIENT_PASSWORD_RESET_WINDOW_MS=3600000
CLIENT_PASSWORD_RESET_MAX=3

# API Indices MtR (MATba-Rofex) - acceso privado
MATBA_API_USERNAME=
MATBA_API_PASSWORD=
MATBA_ACCESS_TOKEN=
MATBA_REFRESH_TOKEN=

# API GIX BCR
BCR_GIX_API_KEY=
BCR_GIX_SECRET=

# Fallback de clima/precipitaciones (opcional)
WEATHERAPI_KEY=
# WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
