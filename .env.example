PORT=3000
# Postgres
# - Local: DATABASE_URL con localhost y tu base.
# - Misma BD que producción (VPS): en el servidor Postgres casi siempre escucha solo en 127.0.0.1,
#   así que desde tu PC no podés poner el host público del VPS en DATABASE_URL (timeout).
#   En una terminal: `LOCAL_PORT=15433 bash scripts/tools/db-tunnel-vps.sh`
#   En .env: misma URL que en el VPS pero con host 127.0.0.1 y puerto LOCAL_PORT (ej. ...@127.0.0.1:15433/...).
#   Valor usuario/clave/base: `ssh root@147.93.36.212 "grep ^DATABASE_URL= /var/www/agro.habilispro.com/.env"` y adaptá host/puerto.
DATABASE_URL=postgresql://usuario:password@localhost:5432/agrohabilis

# Backups PostgreSQL (scripts/backup/backup-dump.js). En tu PC: BACKUP_SSH_TARGET + BACKUP_REMOTE_APP_DIR y npm run backup:pull
# BACKUP_LOCAL_DIR=/ruta/absoluta/backups
# PGDUMP_BIN=/usr/bin/pg_dump
# PGDUMP_VERBOSE=1
# Solo en tu máquina local (no subir al VPS si no hace falta):
# BACKUP_SSH_TARGET=usuario@ip_o_host
# BACKUP_REMOTE_APP_DIR=/ruta/absoluta/al/repo/en/vps
# BACKUP_SSH_EXTRA=-i /home/tu/.ssh/id_ed25519
# Rotación de agrohabilis_*.dump en BACKUP_LOCAL_DIR (npm run backup:rotate o scripts/backup/backup-cron.sh). 0 = desactivar
# BACKUP_RETENTION_DAYS=14

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Consultas WhatsApp (plantilla consulta): con GEMINI_API_KEY, una respuesta conversacional desde JSON de datos antes del editor+plantilla. Desactivar: CONSULTA_IA_PRIMERO=0|false|off
# CONSULTA_IA_PRIMERO=0
# Inventario WhatsApp + Gemini (GEMINI_API_KEY): un solo paso de agente (intención + extracción o respuesta guía en prosa); heurística y extracción estrecha solo si falla la IA o INVENTARIO_NL_LLM=0|false|off
# INVENTARIO_NL_LLM=1
# (Obsoleto) Capa Gemini previa al router: código archivado en obsoletos/consultas/capa_usuario_llm.js — no cargar esperando comportamiento actual.
# CONSULTA_CAPA_USUARIO_LLM=1
# Clasificador de intención WhatsApp (solo JSON; sin fuentes.md ni Groq/OpenRouter). Si no definís modelo, usa GEMINI_MODEL.
# GEMINI_INTENT_MODEL=gemini-flash-latest
# INTENT_CLASSIFIER_MODEL=gemini-flash-latest
# INTENT_CLASSIFIER_TIMEOUT_MS=8000
# INTENT_CLASSIFIER_MAX_OUTPUT_TOKENS=256
# Google Search grounding (Gemini): con GEMINI_API_KEY configurada queda activo por defecto en consultas con huecos (hortícolas, precio sin BD, etc.). Desactivar: GEMINI_GROUNDING_ENABLED=0|false|off
# GEMINI_GROUNDING_ENABLED=0
# GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# GEMINI_GROUNDING_MAX_CHARS=1000
# GEMINI_GROUNDING_TIMEOUT_MS=28000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Límite por proveedor (axios Groq/OpenRouter y tope en Gemini SDK), ms
IA_TIMEOUT_MS=15000
# Orden de fallback entre proveedores (coma)
IA_PROVIDER_ORDER=gemini,groq,openrouter

# Precio (granos) — gate por IA + critic post-render (`src/services/rutas/precio.js`). Requiere al menos una key: OPENROUTER / GEMINI / GROQ, **o** Ollama local (`OLLAMA_ENABLED=1`).
# Orden solo para llamadas JSON del agent gate (gate cultivo ambiguo + critic). Default: openrouter,gemini,groq y, si Ollama está habilitado, se agrega `ollama` al final.
# AGENT_GATE_IA_ORDER=openrouter,gemini,groq
# Ayudante IA local (Ollama): sin API key. Instalación: https://ollama.com/ — `ollama pull qwen2.5:3b` (recomendado para JSON) o `ollama pull llama3.2`. En la cadena JSON del agente **siempre va al final** (resguardo), aunque lo listes antes en AGENT_*_IA_ORDER.
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL recomendado para gates JSON (español + instrucciones): qwen2.5:3b. Alternativa ligera: llama3.2
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_MS=120000
# Prueba: OLLAMA_ENABLED=1 npm run test:ollama
# Critic: tras renderizar, la IA revisa alineación pregunta↔respuesta (sin inventar números). Activar: 1|true|yes|on
# PRECIO_CRITIC_IA=1
# Repregunta si el usuario pide plaza/puerto sin nombrar uno (contexto mercado). Por defecto activo; desactivar: 0|false|off|no
# PRECIO_GATE_PLAZA=0

# Orquestador de turno (dominio agro vs fuera de foco): repregunta cordial sin web cuando no es consulta operativa agro.
# Desactivar y volver al comportamiento previo (p. ej. no_agro con grounding): AGENT_DOMINIO_TURNO=0
# AGENT_DOMINIO_TURNO=1
# Modo: vacío o cualquier valor distinto de "hibrido" = una sola decisión por IA (más parecido a agente). Sin API keys se usa respaldo mínimo.
# AGENT_DOMINIO_MODO=hibrido
# Clasificador: tras fallo de Groq/Gemini, sin CLASSIFIER_FALLBACK y con alguna key (OpenRouter/Gemini/Groq) → agro_general baja (sin heurística). Forzar heurística: CLASSIFIER_FALLBACK=heuristica
# CLASSIFIER_FALLBACK=heuristica
# Orden de proveedores JSON solo para ese gate (default: misma cadena que agent/ia/json_chain y AGENT_GATE_IA_ORDER; puede incluir `ollama` si OLLAMA_ENABLED=1)
# AGENT_DOMINIO_IA_ORDER=openrouter,gemini,groq

# Reintentos del router si la respuesta queda vacía o demasiado corta (1–4; default 2)
# AGENT_VERIFY_ROUTER_MAX=2

# Cadena genérica observe→act→verify: `runObserveActVerifyChain` (router como primer paso; ampliable con más pasos en código).
# Scout con tool-calling OpenRouter (antes del router): el modelo puede llamar tools registradas y el resumen va a `agro_general`.
# Requiere OPENROUTER_API_KEY y modelo con soporte de tools (probar con un modelo distinto de openrouter/free si falla).
# AGENT_TOOL_LOOP_SCOUT=1
# Intenciones donde corre el scout (coma). Vacío = todas las intenciones si el scout está activo.
# AGENT_TOOL_LOOP_SCOUT_INTENTS=agro_general
# Herramientas expuestas al LLM (coma). Default: agent.workspace_doc,agent.historial_snippet
# AGENT_LLM_TOOL_ALLOWLIST=agent.workspace_doc,agent.historial_snippet
# AGENT_TOOL_LOOP_MAX_TURNS=5
# AGENT_TOOL_LOOP_MAX_TOOL_CALLS=6
# AGENT_TOOL_LOOP_TIMEOUT_MS=20000

# Cola PG de consultas: el handler encola y responde “procesando…”; otro hilo en el mismo proceso Node drena y envía por WA (un solo cliente; no es un segundo proceso OS).
# Migración: scripts/db/migrations/20260511_agent_tarea_fila.sql — npm run db:migrate
# AGENT_CONSULTA_ASYNC=1
# AGENT_COLA_POLL_MS=900

# TurnController (P2#10) — migración gradual del dispatcher de whatsapp.js.
# Con OFF, el comportamiento es idéntico al actual (código viejo intacto).
# Para activar: AGENT_TURN_CONTROLLER=1
# Para limitar a handlers específicos (whitelist coma-separada):
#   AGENT_TURN_CONTROLLER_HANDLERS=cmd_flete
# Estado de migración: src/services/turn_handlers/README.md
# Plan de pasos:        docs/operacion/turn-controller-propuesta.md
# AGENT_TURN_CONTROLLER=0
# AGENT_TURN_CONTROLLER_HANDLERS=cmd_flete
# Reabrir tareas en `processing` colgadas (minutos sin terminar → vuelven a `pending`)
# AGENT_COLA_STUCK_MINUTES=15
# Cada cuánto intenta el reclaim (ms; default 60000)
# AGENT_COLA_RECLAIM_EVERY_MS=60000
# Drenar una tarea manualmente (sin WA): npm run agent:cola-once

# Plantilla WhatsApp `consulta` (renderTemplate → consulta.js): redacción por `generarConPromptLibre` (Gemini) + grounding opcional.
# El agente con tools (`consulta_agent_openrouter.js`) ya no se cablea desde `renderizar`; las variables siguientes quedan solo por compatibilidad / otros usos del módulo.
# AGENT_CONSULTA_USE_TEMPLATE=0
# Si en el futuro se reactiva el wiring: AGENT_CONSULTA_IA_ORDER, allowlist, límites de turnos/tools.
# Orden de preferencia del agente (coma): openrouter,gemini — primero con API key.
# AGENT_CONSULTA_IA_ORDER=openrouter,gemini
# AGENT_CONSULTA_TOOL_ALLOWLIST=agent.consulta_datos_compactos,agent.workspace_doc,agent.historial_snippet
# AGENT_CONSULTA_MAX_TURNS=8
# AGENT_CONSULTA_MAX_TOOL_CALLS=10

WHATSAPP_SESSION_PATH=./.wwebjs_auth
WHATSAPP_CLIENT_ID=agrohabilis
# Solo digitos, sin +. Varios admins: separados por coma (ej: 5492494650386,54911...)
WHATSAPP_DESTINO=
WHATSAPP_ADMIN_NUMBERS=
# En VPS conviene ruta fuera del deploy: WHATSAPP_SESSION_PATH=/var/lib/agrohabilis/whatsapp-session
# Reintentos de QR antes de desconectar (default 200; max interno 10000)
# WHATSAPP_QR_MAX_RETRIES=300
# Reintentos de client.initialize() tras desconexion (default 10; max 100)
# WHATSAPP_MAX_RECONNECT_ATTEMPTS=15
# QR en terminal: por defecto tamaño grande (Unicode). Pantalla angosta / logs: WHATSAPP_QR_TERMINAL_SMALL=1 (ASCII chico)
# WHATSAPP_QR_TERMINAL_SMALL=
# PNG del QR solo en disco (junto a WHATSAPP_SESSION_PATH, no publico). Desactivar: WHATSAPP_QR_PNG=0
# WHATSAPP_QR_PNG=1
# Ruta fija al PNG (absoluta o relativa al cwd); por defecto: <session>/_whatsapp_linking_qr.png
# WHATSAPP_QR_PNG_PATH=
# Tras conectar: procesar mensajes no leidos (1:default). Desactivar: WHATSAPP_DRENAR_NO_LEIDOS=0
# WHATSAPP_DRENAR_NO_LEIDOS=1
# Espera ms antes del drenaje (evita solaparse con eventos message al reconectar)
# WHATSAPP_DRENAR_DELAY_MS=2500

# Solo dígitos, sin +. Lista de hasta 32 números: guarda en BD cada mensaje usuario + cada respuesta del bot (hilo completo) para análisis / tuning. Export: npm run export:capturas
CAPTURA_HILO_WHATSAPP=

# VPS: ruta al Chromium del sistema (opcional; evita fallos de libs con el Chrome embebido)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=
MP_SUB_BACK_URL=
WHATSAPP_RETURN_URL=https://wa.me/?text=Hola%20AgroHabilis
# Con token TEST- usar checkout sandbox (por defecto sí). Forzar sandbox: MP_FORCE_SANDBOX_CHECKOUT=1
MP_FORCE_SANDBOX_CHECKOUT=
MP_CURRENCY_ID=ARS
MP_SUB_FREQUENCY=1
MP_SUB_FREQUENCY_TYPE=months
PLAN_BASICO_MONTO=9000
PLAN_PRO_MONTO=18000
JWT_SECRET=
ADMIN_KEY=
# Horas en que un masivo admin sigue en historial como contexto de “feedback” (luego se excluye; default 24, máx. 168)
# BROADCAST_FEEDBACK_WINDOW_HOURS=24
# Pausa entre mensajes del envío masivo admin (ms); reduce riesgo de límites de WhatsApp
ADMIN_BROADCAST_DELAY_MS=650
# Espera máx. a que WhatsApp esté listo antes de arrancar un envío masivo (ms; VPS lento / post-restart)
ADMIN_BROADCAST_WHATSAPP_READY_MS=180000
# Espera máx. antes de cada sendMessage si el cliente aún no está listo (ms)
WHATSAPP_SEND_READY_TIMEOUT_MS=120000
CLIENT_DASHBOARD_URL=https://agro.habilispro.com/dashboard/cliente/login
CLIENT_SESSION_TTL_MS=43200000
CLIENT_TEMP_PASSWORD_LENGTH=10
CLIENT_TEMP_PASSWORD_TTL_HOURS=24
CLIENT_PASSWORD_BCRYPT_ROUNDS=10
CLIENT_LOGIN_RATE_LIMIT_WINDOW_MS=900000
CLIENT_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# Reenvío de contraseña temporal (panel cliente): ventana y tope por IP+número
CLIENT_PASSWORD_RESET_WINDOW_MS=3600000
CLIENT_PASSWORD_RESET_MAX=3

# API Indices MtR (MATba-Rofex) - acceso privado
MATBA_API_USERNAME=
MATBA_API_PASSWORD=
MATBA_ACCESS_TOKEN=
MATBA_REFRESH_TOKEN=

# API GIX BCR
BCR_GIX_API_KEY=
BCR_GIX_SECRET=

# Fallback de clima/precipitaciones (opcional)
WEATHERAPI_KEY=
# WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
